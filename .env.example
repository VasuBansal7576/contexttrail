# Copy to .env.local for a local preview. No credentials are needed for tests/build.
# Every live-provider gate stays disabled. Keys alone never enable retrieval.
CONTEXTTRAIL_LIVE_ENABLED=false
CONTEXTTRAIL_FREE_ALLOWANCE_ACKNOWLEDGED=false
RUN_LIVE_TESTS=0

# Explicit local storage/decoder opt-ins, disabled in this template.
CONTEXTTRAIL_RESEARCH_LOCAL=0
CONTEXTTRAIL_MEDIA_LOCAL=0
# CONTEXTTRAIL_RESEARCH_DATA_DIR=/absolute/path/to/persistent/local-cases

# Existing authorized server credentials only. Never use NEXT_PUBLIC_ names.
SERPAPI_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Live setup additionally requires the existing persistent ledger and verified
# allocation. Follow docs/live-usage.md; do not create or reset a ledger by copying
# this file, and do not enable providers merely to check the interface.
